
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Everyday Tools</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      text-align: center;
      padding: 30px 15px;
    }
    h1 { color: #2563eb; }
    .tool {
      background: white;
      padding: 20px;
      margin: 15px auto;
      max-width: 350px;
      border-radius: 12px;
    }
    input, button {
      padding: 12px;
      margin: 5px;
      font-size: 16px;
    }
  </style>
</head>
<body>
  <h1>Everyday Tools</h1>
  <p>Free tools for everyday life</p>

  <div class="tool">
    <h2>Calculator</h2>
    <input id="a" type="number" placeholder="First number">
    <input id="b" type="number" placeholder="Second number">
    <button onclick="calculate()">Add numbers</button>
    <p id="result">Result: </p>
  </div>

  <script>
    function calculate() {
      const a = Number(document.getElementById('a').value);
      const b = Number(document.getElementById('b').value);
      document.getElementById('result').textContent =
        'Result: ' + (a + b);
    }
  </script>
</body>
</html>
